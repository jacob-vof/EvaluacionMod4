<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity2">

    <LinearLayout
        android:id="@+id/layoutTop"
        android:gravity="center"
        android:layout_width="match_parent"
        android:layout_height="300dp"
        android:background="@color/amarillo"
        android:orientation="vertical"
        android:paddingTop="50dp"
        android:layout_marginTop="100dp"
        tools:layout_editor_absoluteX="2dp"
        tools:layout_editor_absoluteY="-1dp">
        <TextView
            android:id="@+id/titulo2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Alucard Farenheit Tepes"
            android:gravity="top"
            android:textSize="20sp"
            android:textStyle="italic"
            android:textAlignment="center"/>


        <ImageView
            android:id="@+id/avatar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:adjustViewBounds="true"
            android:scaleType="fitCenter"
            app:srcCompat="@mipmap/ic_alucard_round" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/layoutMid"
        android:gravity="center"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="30dp"
        tools:layout_editor_absoluteX="2dp"
        tools:layout_editor_absoluteY="167dp"
        app:layout_constraintTop_toBottomOf="@+id/layoutTop"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintStart_toEndOf="parent"
        >


        <ImageView
            android:id="@+id/imLink"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:srcCompat="@mipmap/ic_linkedin_round" />

        <ImageView
            android:id="@+id/imTel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:srcCompat="@mipmap/ic_telegram" />

        <ImageView
            android:id="@+id/imWhats"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:srcCompat="@mipmap/ic_whatsapp_round" />

        <ImageView
            android:id="@+id/imCorre"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:srcCompat="@mipmap/ic_correo_foreground" />


    </LinearLayout>

    <LinearLayout
        android:id="@+id/layoutBot"
        android:layout_width="409dp"
        android:layout_height="238dp"
        android:orientation="vertical"
        android:gravity="center"
        tools:layout_editor_absoluteX="1dp"
        tools:layout_editor_absoluteY="492dp"
        app:layout_constraintTop_toBottomOf="@+id/layoutMid"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintStart_toEndOf="parent">


        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRegreso"
            android:text="Volver"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAlignment="center"/>




    </LinearLayout>


</androidx.constraintlayout.widget.ConstraintLayout>