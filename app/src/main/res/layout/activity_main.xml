<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    tools:context=".MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        tools:layout_editor_absoluteX="1dp"
        android:gravity="center"
        tools:layout_editor_absoluteY="1dp">


        <TextView
            android:id="@+id/titulo"
            android:layout_width="match_parent"
            android:layout_height="89dp"
            android:gravity="top"
            android:textAlignment="center"
            android:textColor="@color/amarillo"
            android:text="Alucard Farenheit Tepes"
            android:textSize="20sp"
            android:textStyle="italic" />

        <ImageView
            android:id="@+id/imageView5"
            android:layout_width="382dp"
            android:layout_height="379dp"
            app:srcCompat="@mipmap/ic_alucard_foreground" />

        <TextView
            android:id="@+id/texCV"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="10dp"
            android:layout_marginTop="35dp"
            android:textColor="@color/rojo"
            android:textAlignment="center"
            android:text="Soy Alucard un experto caza vampiros&#10; Soy mitad hombre mitad vampiro &#10; Cazo todo tipo de criaturas" />

        <Button
            android:id="@+id/btnAct"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ir a mis redes"
            android:layout_marginTop="150dp"
            android:textAlignment="center" />



    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>